# Copy to nightly.env (gitignored) to change how the unattended nightly run behaves.

# Which language-model backends may write your resume wording, in order.
#   ollama  = local model (default; free; needs `ollama serve` and the model pulled)
#   claude  = Claude Code headless (`claude -p`). Only add this for an account that is yours to automate:
#             a work/Team plan usually is not.
JOOB_LLM_ORDER=ollama

# Hard caps. Claude is also skipped when ~/.claude.json shows 5-hour or weekly usage above these percentages.
JOOB_MAX_CLAUDE_CALLS=20
JOOB_MAX_FIVE_HOUR_UTIL=60
JOOB_MAX_WEEKLY_UTIL=60

JOOB_JOB_LIMIT=25        # resumes per night
JOOB_MAX_AGE_DAYS=7      # ignore scraped jobs older than this
JOOB_SKIP_INTERNSHIPS=1
